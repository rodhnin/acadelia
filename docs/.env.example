############################
#  Acadelia – .env.example #
############################

# ========= App =========
NODE_ENV=development
PORT=5000
APP_BASE_URL=http://localhost:5000
DOMAIN_URL=http://localhost:5000
MAINTENANCE_MODE=false
TERMS_VERSION=1.0

# ========= Database / Supabase =========
# Conexión local (si la usas)
DATABASE_URL=postgres://user:pass@localhost:5432/acadelia

# Proyecto Supabase
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_key

# (Opcional) Conexión directa al pooler/host
SUPABASE_HOST=localhost
SUPABASE_PORT=5432
SUPABASE_USER=postgres
SUPABASE_PASSWORD=postgres
SUPABASE_DATABASE=postgres

# ========= Redis (obligatorio) =========
REDIS_HOST=localhost
REDIS_PORT=6379

# ========= IA / OCR / Transcripción =========
OPENAI_API_KEY=sk-xxxx
MISTRAL_API_KEY=xxxx
YOUTUBE_API_KEY=xxxx
RAPIDAPI_KEY=xxxx
RAPIDAPI_HOST=youtube-mp3-2025.p.rapidapi.com
RAPIDAPI_USERNAME=your_rapidapi_username

# ========= Búsqueda / Cálculo / Otros =========
BRAVE_SEARCH_API_KEY=xxxx
WOLFRAM_APP_ID=xxxx
MINIMAX_API_KEY=xxxx
MINIMAX_GROUP_ID=xxxx

# ========= Seguridad =========
JWT_SECRET=change-me
SESSION_SECRET=change-me
CSRF_SECRET=change-me
RATE_LIMIT_MAX=100
CSP_ENABLED=true
SECURITY_BYPASS=false

# Timers (limpieza / auditoría)
SECURITY_ARCHIVE_DAYS=90
SECURITY_DELETE_DAYS=365
LOGIN_DELETE_DAYS=30

# ========= Correo / Feedback =========
EMAIL_SERVICE=gmail
EMAIL_USER=you@example.com
EMAIL_APP_PASSWORD=app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=$EMAIL_USER
SMTP_PASS=$EMAIL_APP_PASSWORD
FEEDBACK_EMAIL=contact@example.com

# ========= Pagos =========
# Paddle
PADDLE_ENV=live
PADDLE_SELLER_API_KEY=xxxx
# (opcional) Vendedores antiguos
PADDLE_VENDOR_ID=

# Ualá Bis (Producción)
UALA_USERNAME=xxxx
UALA_CLIENT_ID=xxxx
UALA_CLIENT_SECRET=xxxx
# Ualá Bis (Stage)
UALA_STAGE_USERNAME=xxxx
UALA_STAGE_CLIENT_ID=xxxx
UALA_STAGE_CLIENT_SECRET=xxxx

# ========= Webhooks (Hookdeck) =========
HOOKDECK_WEBHOOK_URL=
HOOKDECK_SIGNING_SECRET=

# ========= Observabilidad (opcional) =========
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Acadelia

# ========= PDF / Procesamiento =========
PDF_MAX_CONCURRENT=4
PDF_PROCESSING_TIMEOUT=60000